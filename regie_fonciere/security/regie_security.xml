<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_regie" model="res.groups.privilege">
        <field name="name">Land Agency</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_real_estate"/>
    </record>

    <!-- Gestionnaire: buildings, units, leases, deposits, indexation proposals -->
    <record id="group_regie_property_manager" model="res.groups">
        <field name="name">Property Manager</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_regie"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Comptable: rent invoicing, charges, charge statements -->
    <record id="group_regie_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_regie"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice'))]"/>
    </record>

    <!-- Responsable: validations and configuration. Future household income data
         must be restricted to this group (groups="regie_fonciere.group_regie_supervisor"). -->
    <record id="group_regie_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_regie"/>
        <field name="implied_ids" eval="[(4, ref('group_regie_property_manager')), (4, ref('group_regie_accountant'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
