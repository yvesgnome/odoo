<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_regie" model="ir.ui.view">
        <field name="name">account.move.form.inherit.regie</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="regie_lease_id" invisible="move_type not in ('out_invoice', 'out_refund')"
                       readonly="state != 'draft'" groups="regie_fonciere.group_regie_property_manager,regie_fonciere.group_regie_accountant"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_inherit_regie" model="ir.ui.view">
        <field name="name">account.move.search.inherit.regie</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="regie_lease_id"/>
                <field name="regie_building_id"/>
            </xpath>
            <xpath expr="//filter[@name='status']" position="after">
                <filter name="group_regie_building" string="Building" context="{'group_by': 'regie_building_id'}"/>
                <filter name="group_regie_lease" string="Lease" context="{'group_by': 'regie_lease_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
