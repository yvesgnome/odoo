<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="regie_lease_view_list" model="ir.ui.view">
        <field name="name">regie.lease.list</field>
        <field name="model">regie.lease</field>
        <field name="arch" type="xml">
            <list string="Leases" decoration-muted="state in ('terminated', 'rescinded')"
                  decoration-danger="state == 'litigation'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="building_id"/>
                <field name="main_unit_id"/>
                <field name="lease_type"/>
                <field name="start_date"/>
                <field name="end_date" optional="show"/>
                <field name="current_rent" sum="Total" optional="show"/>
                <field name="current_charge_provision" sum="Total" optional="show"/>
                <field name="open_balance" optional="show"/>
                <field name="overdue_invoice_count" optional="hide"/>
                <field name="structured_communication" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'notice'"
                       decoration-danger="state == 'litigation'"
                       decoration-info="state in ('draft', 'signed')"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="regie_lease_view_form" model="ir.ui.view">
        <field name="name">regie.lease.form</field>
        <field name="model">regie.lease</field>
        <field name="arch" type="xml">
            <form string="Lease">
                <header>
                    <button name="action_sign" string="Mark as Signed" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_activate" string="Activate" type="object"
                            invisible="state != 'signed'"/>
                    <button name="action_give_notice" string="Give Notice" type="object"
                            invisible="state != 'active'"/>
                    <button name="action_terminate" string="Terminate" type="object"
                            invisible="state not in ('active', 'notice', 'litigation')"
                            confirm="Terminate this lease? The move-out date must be set."/>
                    <button name="action_rescind" string="Rescind" type="object"
                            invisible="state not in ('active', 'notice', 'litigation')"
                            confirm="Rescind this lease? The move-out date must be set."/>
                    <button name="action_set_litigation" string="Litigation" type="object"
                            invisible="state not in ('active', 'notice')"/>
                    <button name="action_end_litigation" string="End Litigation" type="object"
                            invisible="state != 'litigation'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state != 'signed'"/>
                    <button name="action_generate_schedule" string="Generate Invoices" type="object"
                            groups="regie_fonciere.group_regie_accountant"
                            invisible="state not in ('active', 'notice', 'litigation', 'terminated', 'rescinded')"/>
                    <button name="action_new_invoice" string="One-off Invoice" type="object"
                            groups="regie_fonciere.group_regie_accountant"
                            invisible="state == 'draft'"/>
                    <button name="action_new_credit_note" string="Credit Note" type="object"
                            groups="regie_fonciere.group_regie_accountant"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,signed,active,notice,terminated"/>
                </header>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not is_housing or reference_rent">
                    The reference rent is a mandatory mention of housing leases.
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                                groups="account.group_account_invoice">
                            <field name="invoice_count" string="Invoices" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="is_housing" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h3><field name="structured_communication" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Lease">
                            <field name="lease_type"/>
                            <field name="partner_id"/>
                            <field name="unit_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="main_unit_id" options="{'no_create': True}"/>
                            <field name="building_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Dates">
                            <field name="signature_date"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="duration_months"/>
                            <field name="next_anniversary_date"/>
                            <field name="notice_date" invisible="state in ('draft', 'signed')"/>
                            <field name="exit_date" invisible="state in ('draft', 'signed')"/>
                        </group>
                        <group string="Rent">
                            <label for="current_rent"/>
                            <div class="o_row">
                                <field name="current_rent"/>
                                <field name="current_rent_explanation" widget="regie_info_tooltip" nolabel="1"/>
                            </div>
                            <field name="current_charge_provision"/>
                            <field name="reference_rent" required="is_housing and state != 'draft'"/>
                            <field name="charge_mode"/>
                        </group>
                        <group string="Balance">
                            <field name="open_balance"/>
                            <field name="overdue_invoice_count" decoration-danger="overdue_invoice_count > 0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tenants" name="tenants">
                            <group>
                                <group>
                                    <field name="tenant_ids" widget="many2many_tags_avatar"/>
                                    <field name="joint_liability"/>
                                </group>
                                <group>
                                    <field name="guarantor_ids" widget="many2many_tags_avatar"/>
                                </group>
                            </group>
                        </page>
                        <page string="Rent" name="rent">
                            <group>
                                <group>
                                    <field name="base_rent" readonly="state != 'draft'"/>
                                    <field name="initial_charge_provision" readonly="state != 'draft'"/>
                                    <field name="initial_index"/>
                                </group>
                            </group>
                            <field name="rent_line_ids">
                                <list editable="bottom" default_order="date_start desc">
                                    <field name="date_start"/>
                                    <field name="rent"/>
                                    <field name="explanation" widget="regie_info_tooltip" string=" " width="30px"/>
                                    <field name="charge_provision"/>
                                    <field name="reason"/>
                                    <field name="note" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Charges" name="charges">
                            <group>
                                <field name="charge_category_ids" widget="many2many_checkboxes"/>
                            </group>
                        </page>
                        <page string="Registration &amp; Indexation" name="registration">
                            <group>
                                <group string="Registration">
                                    <field name="is_written"/>
                                    <field name="registration_date"/>
                                    <field name="registration_reference"/>
                                    <field name="registration_document" filename="registration_document_name"/>
                                    <field name="registration_document_name" invisible="1"/>
                                </group>
                                <group string="Indexation" name="indexation">
                                    <field name="is_indexable"/>
                                    <field name="indexation_excluded"/>
                                    <field name="peb_communicated" invisible="not is_housing"/>
                                </group>
                            </group>
                        </page>
                        <page string="Invoicing" name="invoicing" groups="account.group_account_invoice">
                            <group>
                                <group name="invoicing_main">
                                    <field name="invoicing_start_date"/>
                                    <field name="vat_option" invisible="lease_type != 'commercial'"/>
                                    <field name="tax_ids" widget="many2many_tags"
                                           invisible="not vat_option" required="vat_option"/>
                                </group>
                                <group name="invoicing_payment">
                                    <field name="sepa_mandate_id" options="{'no_create': True}"/>
                                </group>
                            </group>
                            <field name="schedule_line_ids" readonly="1">
                                <list decoration-muted="state == 'cancelled'" decoration-info="state == 'to_invoice'">
                                    <field name="period_date" widget="date" options="{'format': 'MM/yyyy'}"/>
                                    <field name="date_from" optional="hide"/>
                                    <field name="date_to" optional="hide"/>
                                    <field name="prorata" optional="show"/>
                                    <field name="rent_amount" sum="Total"/>
                                    <field name="charge_amount" sum="Total"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="explanation" widget="regie_info_tooltip" string=" " width="30px"/>
                                    <field name="invoice_id"/>
                                    <field name="payment_state" widget="badge" optional="show"
                                           decoration-success="payment_state in ('paid', 'in_payment')"
                                           decoration-danger="payment_state == 'not_paid'"
                                           decoration-warning="payment_state == 'partial'"/>
                                    <field name="state" widget="badge"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="regie_lease_view_search" model="ir.ui.view">
        <field name="name">regie.lease.search</field>
        <field name="model">regie.lease</field>
        <field name="arch" type="xml">
            <search string="Leases">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('structured_communication', 'ilike', self)]"/>
                <field name="partner_id" filter_domain="['|', ('partner_id', 'child_of', raw_value), ('tenant_ids', 'child_of', raw_value)]"/>
                <field name="building_id"/>
                <field name="unit_ids"/>
                <filter name="running" string="Running" domain="[('state', 'in', ('active', 'notice', 'litigation'))]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="notice" string="Notice Given" domain="[('state', '=', 'notice')]"/>
                <filter name="litigation" string="Litigation" domain="[('state', '=', 'litigation')]"/>
                <filter name="ended" string="Ended" domain="[('state', 'in', ('terminated', 'rescinded'))]"/>
                <separator/>
                <filter name="housing" string="Housing" domain="[('is_housing', '=', True)]"/>
                <filter name="not_registered" string="Not Registered" domain="[('is_registered', '=', False)]"/>
                <filter name="ending_soon" string="Ending within 6 Months"
                        domain="[('end_date', '!=', False), ('end_date', '&lt;=', (context_today() + relativedelta(months=6)).strftime('%Y-%m-%d')), ('state', 'in', ('active', 'notice', 'litigation'))]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="group_building" string="Building" context="{'group_by': 'building_id'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'lease_type'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="regie_lease_action" model="ir.actions.act_window">
        <field name="name">Leases</field>
        <field name="res_model">regie.lease</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_running': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a lease</p>
            <p>A lease rents one or more units to one or more tenants.</p>
        </field>
    </record>

    <record id="regie_lease_ending_action" model="ir.actions.act_window">
        <field name="name">Leases Ending within 6 Months</field>
        <field name="res_model">regie.lease</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_ending_soon': 1}</field>
    </record>

    <!-- Charge categories -->
    <record id="regie_charge_category_view_list" model="ir.ui.view">
        <field name="name">regie.charge.category.list</field>
        <field name="model">regie.charge.category</field>
        <field name="arch" type="xml">
            <list string="Charge Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="regie_charge_category_action" model="ir.actions.act_window">
        <field name="name">Charge Categories</field>
        <field name="res_model">regie.charge.category</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
