<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="regie_deposit_view_list" model="ir.ui.view">
        <field name="name">regie.deposit.list</field>
        <field name="model">regie.deposit</field>
        <field name="arch" type="xml">
            <list string="Rental Deposits" decoration-muted="state in ('released', 'retained')"
                  decoration-warning="exceeds_cap">
                <field name="lease_id"/>
                <field name="partner_id"/>
                <field name="building_id" optional="show"/>
                <field name="deposit_type"/>
                <field name="amount" sum="Total"/>
                <field name="constituted_amount" sum="Total"/>
                <field name="bank_name" optional="hide"/>
                <field name="account_reference" optional="hide"/>
                <field name="retained_amount" optional="show"/>
                <field name="exceeds_cap" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'requested'"
                       decoration-warning="state in ('partial', 'release_requested')"
                       decoration-success="state == 'constituted'"
                       decoration-danger="state == 'retained'"/>
            </list>
        </field>
    </record>

    <record id="regie_deposit_view_form" model="ir.ui.view">
        <field name="name">regie.deposit.form</field>
        <field name="model">regie.deposit</field>
        <field name="arch" type="xml">
            <form string="Rental Deposit">
                <header>
                    <button name="action_mark_constituted" string="Mark as Constituted" type="object" class="btn-primary"
                            invisible="state not in ('requested', 'partial')"/>
                    <button name="action_compute_retentions" string="Compute Retentions" type="object"
                            invisible="state not in ('constituted', 'partial', 'release_requested')"/>
                    <button name="action_request_release" string="Request Release" type="object"
                            invisible="state not in ('constituted', 'partial')"/>
                    <button name="action_print_release_form" string="Release Form" type="object"
                            invisible="state not in ('release_requested', 'released', 'retained')"/>
                    <button name="action_release" string="Mark as Released" type="object" class="btn-primary"
                            invisible="state != 'release_requested'"/>
                    <button name="action_reset" string="Reset" type="object"
                            invisible="state not in ('release_requested', 'released', 'retained')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="requested,constituted,release_requested,released"/>
                </header>
                <div class="alert alert-warning mb-0" role="alert" invisible="not exceeds_cap">
                    The deposit exceeds the legal cap of a housing lease
                    (<field name="cap_amount" class="oe_inline"/>, rent excluding charges).
                </div>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <field name="exceeds_cap" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Deposit">
                            <field name="lease_id"/>
                            <field name="partner_id"/>
                            <field name="deposit_type"/>
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="constituted_amount"/>
                        </group>
                        <group string="Bank or Guarantor">
                            <field name="bank_name"/>
                            <field name="bank_bic"/>
                            <field name="account_reference"/>
                            <field name="lease_state"/>
                            <field name="exit_date"/>
                        </group>
                    </group>
                    <group string="Release" invisible="state in ('requested', 'partial', 'constituted') and not release_request_date">
                        <group>
                            <field name="release_request_date"/>
                            <field name="release_date"/>
                            <field name="unpaid_rent_amount" readonly="state in ('released', 'retained')"/>
                            <field name="unpaid_charges_amount" readonly="state in ('released', 'retained')"/>
                            <field name="damage_amount" readonly="state in ('released', 'retained')"/>
                        </group>
                        <group>
                            <field name="retained_amount"/>
                            <field name="released_amount"/>
                            <field name="retention_reason" readonly="state in ('released', 'retained')"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="regie_deposit_view_search" model="ir.ui.view">
        <field name="name">regie.deposit.search</field>
        <field name="model">regie.deposit</field>
        <field name="arch" type="xml">
            <search string="Rental Deposits">
                <field name="lease_id"/>
                <field name="partner_id"/>
                <field name="building_id"/>
                <filter name="pending" string="Not Constituted" domain="[('state', 'in', ('requested', 'partial'))]"/>
                <filter name="release" string="Release Requested" domain="[('state', '=', 'release_requested')]"/>
                <filter name="closed" string="Released or Retained" domain="[('state', 'in', ('released', 'retained'))]"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_type" string="Form" context="{'group_by': 'deposit_type'}"/>
            </search>
        </field>
    </record>

    <record id="regie_deposit_action" model="ir.actions.act_window">
        <field name="name">Rental Deposits</field>
        <field name="res_model">regie.deposit</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>

    <record id="regie_lease_view_form_deposit" model="ir.ui.view">
        <field name="name">regie.lease.form.deposit</field>
        <field name="model">regie.lease</field>
        <field name="inherit_id" ref="regie_lease_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_deposits" type="object" class="oe_stat_button" icon="fa-lock">
                    <field name="deposit_count" string="Deposits" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
