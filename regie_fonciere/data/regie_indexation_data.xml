<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_regie_indexation_proposals" model="ir.cron">
        <field name="name">Land Agency: create indexation proposals</field>
        <field name="model_id" ref="model_regie_lease"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_indexation_proposals()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:00:00')"/>
    </record>
</odoo>
