<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Taxes are never taken from the products: rent lines get the taxes of the lease (VAT option). -->
        <record id="product_rent" model="product.product">
            <field name="name">Rent</field>
            <field name="default_code">REGIE-RENT</field>
            <field name="type">service</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">0</field>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
            <field name="supplier_taxes_id" eval="[(5, 0, 0)]"/>
        </record>
        <record id="product_charge_provision" model="product.product">
            <field name="name">Charge Provision</field>
            <field name="default_code">REGIE-CHARGES</field>
            <field name="type">service</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">0</field>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
            <field name="supplier_taxes_id" eval="[(5, 0, 0)]"/>
        </record>

        <record id="ir_cron_regie_generate_invoices" model="ir.cron">
            <field name="name">Land Agency: generate rent invoices</field>
            <field name="model_id" ref="model_regie_lease"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:00:00')"/>
        </record>
    </data>

    <record id="action_server_regie_lease_generate_schedule" model="ir.actions.server">
        <field name="name">Generate Rent Invoices</field>
        <field name="model_id" ref="model_regie_lease"/>
        <field name="binding_model_id" ref="model_regie_lease"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('group_regie_accountant'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_generate_schedule()</field>
    </record>
</odoo>
